#!/usr/bin/env bash
# Prepares an Amp orb for this static site: preinstalls live-server (so `npx live-server`
# does not download it every time) and points scripts/generate-resume-pdf.sh at the orb's Chrome.
set -euo pipefail

LIVE_SERVER_VERSION="1.2.2"

step() { printf '\n==> %s\n' "$*"; }

step "live-server ${LIVE_SERVER_VERSION}"
SECONDS=0
if [[ "$(npm ls -g live-server --depth=0 --json 2>/dev/null | jq -r '.dependencies["live-server"].version // empty')" == "$LIVE_SERVER_VERSION" ]]; then
  echo "already installed"
else
  npm install -g --no-fund --no-audit "live-server@${LIVE_SERVER_VERSION}"
fi
echo "took ${SECONDS}s"

step "CHROME_BIN for resume PDF generation"
# The orb ships Chrome for Testing for agent-browser in a versioned directory; resolve it at login.
profile_marker="# jdorfman/www: CHROME_BIN for scripts/generate-resume-pdf.sh"
if grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  echo "already configured"
else
  cat >> "$HOME/.bash_profile" <<'EOF'

# jdorfman/www: CHROME_BIN for scripts/generate-resume-pdf.sh
if [[ -z "${CHROME_BIN:-}" ]]; then
  for _chrome in $(ls -d "$HOME"/.agent-browser/browsers/chrome-*/chrome 2>/dev/null | sort -V -r); do
    [[ -x "$_chrome" ]] && export CHROME_BIN="$_chrome" && break
  done
  unset _chrome
fi
EOF
  echo "added to ~/.bash_profile"
fi
